{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bootstrap-theme/bs-split-carousel",
    "title": "Split Carousel",
    "category": "ileben-landing",
    "icon": "images-alt2",
    "description": "Carousel layout with split text/image columns",
    "keywords": [
        "carousel",
        "slider",
        "split"
    ],
    "textdomain": "ileben-landing",
    "supports": {
        "html": false,
        "anchor": true,
        "customClassName": true
    },
    "attributes": {
        "carouselId": {
            "type": "string",
            "default": ""
        },
        "interval": {
            "type": "string",
            "default": "5000"
        },
        "leftTransition": {
            "type": "string",
            "default": "fade"
        },
        "rightTransition": {
            "type": "string",
            "default": "fade"
        },
        "transitionDuration": {
            "type": "number",
            "default": 0.6
        },
        "staggerDelay": {
            "type": "number",
            "default": 0.15
        }
    }
}
